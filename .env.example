# RPC endpoint for Unichain
RPC_URL=https://mainnet.unichain.org

# Your LP position token ID (from POSM contract)
POSITION_TOKEN_ID=1

# Position Manager contract address
POSM_ADDRESS=0x...

# State view contract address (for reading pool state)
STATE_VIEW_ADDRESS=0x...

# beaconcha.in API key (for validator status)
BEACONCHAIN_API_KEY=

# Ethereum mainnet RPC (for wallet ETH balances)
MAINNET_RPC_URL=

# Unichain USDC token address (checksummed)
UNICHAIN_USDC_ADDRESS=

# Comma-separated validator indices (e.g., 1039,14520)
VALIDATOR_INDICES=

# Comma-separated list; use "Label:address" or just the address. Example:
# MONITORED_ADDRESSES=Wallet 1:0xabc...,Wallet 2:0xdef...
MONITORED_ADDRESSES=
